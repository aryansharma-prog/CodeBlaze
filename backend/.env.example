# =============================================================================
# CodeBlaze Backend Environment Variables (Template)
# =============================================================================

# Server Port
PORT=4000

# MongoDB Atlas Connection URI
DB_CONNECT_STRING=mongodb+srv://<username>:<password>@cluster.mongodb.net/codeblaze?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_KEY=your_jwt_secret_key_here

# Redis Cloud / Upstash Connection URI
REDIS_CONNECTION=redis://default:<password>@<host>:<port>

# Google Gemini API Key
GEMINI_KEY=your_gemini_api_key_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Frontend Origin (CORS)
VITE_BACKEND_URL=https://code-blaze-git-main-aryansharma-progs-projects.vercel.app
